{
  "name": "@age.nt/nt",
  "version": "0.6.0",
  "description": "The `nt` command-line interface for running NT agent ecosystems.",
  "type": "module",
  "license": "MIT",
  "author": "Kartik Mehta <kartikmehta202@gmail.com>",
  "bin": {
    "nt": "./bin/nt.mjs"
  },
  "imports": {
    "#*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm --filter @age.nt/engine build && pnpm run build",
    "test": "node --conditions=development --test \"test/*.test.ts\""
  },
  "keywords": [
    "nt",
    "ai",
    "agents",
    "cli",
    "llm",
    "anthropic",
    "dsl",
    "workflow"
  ],
  "homepage": "https://github.com/kartikmehta8/nt#readme",
  "bugs": {
    "url": "https://github.com/kartikmehta8/nt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kartikmehta8/nt.git",
    "directory": "packages/cli"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@age.nt/engine": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
