{
  "name": "@age.nt/engine",
  "version": "0.7.0",
  "description": "The NT language and runtime engine: parser, schema, providers, sandboxes, and the agentic session loop.",
  "type": "module",
  "license": "MIT",
  "author": "Kartik Mehta <kartikmehta202@gmail.com>",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm run build",
    "test": "node --conditions=development --test \"test/*.test.ts\""
  },
  "keywords": [
    "nt",
    "ai",
    "agents",
    "engine",
    "llm",
    "anthropic",
    "dsl",
    "parser",
    "runtime"
  ],
  "homepage": "https://github.com/kartikmehta8/nt#readme",
  "bugs": {
    "url": "https://github.com/kartikmehta8/nt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kartikmehta8/nt.git",
    "directory": "packages/engine"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "ajv": "8.20.0",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  }
}
