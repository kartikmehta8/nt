{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NT",
  "scopeName": "source.nt",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#import"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#blockScalarListItem"
    },
    {
      "include": "#blockScalar"
    },
    {
      "include": "#whenCondition"
    },
    {
      "include": "#forEachRef"
    },
    {
      "include": "#mapping"
    },
    {
      "include": "#listItem"
    },
    {
      "include": "#valueAtoms"
    }
  ],
  "repository": {
    "import": {
      "match": "^(import)\\b\\s+(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.control.import.nt"
        },
        "2": {
          "name": "string.unquoted.path.nt"
        }
      }
    },
    "comment": {
      "match": "(?:(?<=\\s)|^)(#).*$",
      "name": "comment.line.number-sign.nt",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.nt"
        }
      }
    },
    "declaration": {
      "match": "^(agent|subagent|sandbox|tool|skill|workflow|provider|mcp|config)\\b(?:\\s+([A-Za-z0-9_-]+))?",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.nt"
        },
        "2": {
          "name": "entity.name.type.nt"
        }
      }
    },
    "blockScalar": {
      "begin": "^(\\s*)([A-Za-z_][A-Za-z0-9_.-]*)(\\s*:)\\s*(\\|-?|>-?)\\s*$",
      "beginCaptures": {
        "2": {
          "name": "entity.name.tag.nt"
        },
        "3": {
          "name": "punctuation.separator.key-value.nt"
        },
        "4": {
          "name": "keyword.operator.block-scalar.nt"
        }
      },
      "end": "^(?!\\1\\s|\\s*$)",
      "contentName": "string.unquoted.block.nt",
      "patterns": [
        {
          "include": "#placeholder"
        }
      ]
    },
    "blockScalarListItem": {
      "begin": "^(\\s*)-\\s+([A-Za-z_][A-Za-z0-9_.-]*)(\\s*:)\\s*(\\|-?|>-?)\\s*$",
      "beginCaptures": {
        "2": {
          "name": "entity.name.tag.nt"
        },
        "3": {
          "name": "punctuation.separator.key-value.nt"
        },
        "4": {
          "name": "keyword.operator.block-scalar.nt"
        }
      },
      "comment": "Content of a `- key: |` block is indented past the key (dash + at least two columns). Sibling keys align with the key, so they end the block.",
      "end": "^(?!\\1\\s\\s\\s|\\s*$)",
      "contentName": "string.unquoted.block.nt",
      "patterns": [
        {
          "include": "#placeholder"
        }
      ]
    },
    "mapping": {
      "begin": "^(\\s*)(?:-\\s+)?([A-Za-z_][A-Za-z0-9_.-]*)(\\s*:)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "entity.name.tag.nt"
        },
        "3": {
          "name": "punctuation.separator.key-value.nt"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#valueAtoms"
        }
      ]
    },
    "listItem": {
      "match": "^(\\s*)(-)(?=\\s|$)",
      "captures": {
        "2": {
          "name": "punctuation.definition.list.begin.nt"
        }
      }
    },
    "valueAtoms": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#env"
        },
        {
          "include": "#dqstring"
        },
        {
          "include": "#sqstring"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#number"
        },
        {
          "include": "#unquoted"
        }
      ]
    },
    "env": {
      "begin": "\\b(env)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "support.function.builtin.nt"
        },
        "2": {
          "name": "punctuation.section.arguments.begin.nt"
        }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.arguments.end.nt"
        }
      },
      "patterns": [
        {
          "include": "#dqstring"
        },
        {
          "include": "#sqstring"
        },
        {
          "match": ",",
          "name": "punctuation.separator.arguments.nt"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.constant.nt"
        }
      ]
    },
    "dqstring": {
      "name": "string.quoted.double.nt",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.nt"
        },
        {
          "include": "#placeholder"
        }
      ]
    },
    "sqstring": {
      "name": "string.quoted.single.nt",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#placeholder"
        }
      ]
    },
    "constant": {
      "match": "(?<![\\w./-])(true|false|null|~)(?![\\w./-])",
      "name": "constant.language.nt"
    },
    "number": {
      "match": "(?<![\\w.-])-?[0-9]+(\\.[0-9]+)?(?![\\w.-])",
      "name": "constant.numeric.nt"
    },
    "unquoted": {
      "begin": "(?=\\S)",
      "end": "$",
      "name": "string.unquoted.nt",
      "patterns": [
        {
          "include": "#placeholder"
        }
      ]
    },
    "whenCondition": {
      "match": "^(\\s*)(?:-\\s+)?(when)(\\s*:)\\s+(?:(not)\\s+)?(\\{?[A-Za-z_][A-Za-z0-9_]*\\}?)(?:\\s+(is(?:\\s+not)?\\s+empty)|\\s*(==|!=)\\s*(.+?))?\\s*$",
      "comment": "A workflow step's `when` uses a fixed six-form predicate vocabulary, so its operators and variable are highlighted rather than treated as one unquoted string.",
      "captures": {
        "2": {
          "name": "entity.name.tag.nt"
        },
        "3": {
          "name": "punctuation.separator.key-value.nt"
        },
        "4": {
          "name": "keyword.operator.logical.nt"
        },
        "5": {
          "name": "variable.other.nt"
        },
        "6": {
          "name": "keyword.operator.comparison.nt"
        },
        "7": {
          "name": "keyword.operator.comparison.nt"
        },
        "8": {
          "name": "string.unquoted.nt",
          "patterns": [
            {
              "include": "#dqstring"
            },
            {
              "include": "#sqstring"
            }
          ]
        }
      }
    },
    "forEachRef": {
      "match": "^(\\s*)(?:-\\s+)?(for_each)(\\s*:)\\s+(\\{?[A-Za-z_][A-Za-z0-9_]*\\}?)\\s*$",
      "captures": {
        "2": {
          "name": "entity.name.tag.nt"
        },
        "3": {
          "name": "punctuation.separator.key-value.nt"
        },
        "4": {
          "name": "variable.other.nt"
        }
      }
    },
    "placeholder": {
      "match": "\\{[A-Za-z_][A-Za-z0-9_]*\\}",
      "name": "variable.other.placeholder.nt"
    }
  }
}
