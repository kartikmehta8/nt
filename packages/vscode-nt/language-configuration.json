{
  "comments": { "lineComment": "#" },
  "brackets": [
    ["[", "]"],
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["{", "}"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(:\\s*$)|(:\\s*[|>]-?\\s*$)|^(agent|subagent|sandbox|tool|skill|workflow|provider|mcp|config)\\b.*$",
    "decreaseIndentPattern": "^\\s+\\S"
  }
}
