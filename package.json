{
  "name": "nt",
  "version": "0.1.0",
  "description": "NT — a declarative .nt language and engine for spinning up ecosystems of AI agents, subagents, sandboxes, tools, skills and workflows.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "nt:setup": "node packages/cli/bin/nt.mjs setup .nt-demo --template full",
    "nt:validate": "node packages/cli/bin/nt.mjs validate --file example/age.nt",
    "nt:list": "node packages/cli/bin/nt.mjs list --file example/age.nt",
    "nt:graph": "node packages/cli/bin/nt.mjs graph --file example/age.nt",
    "nt:up": "node packages/cli/bin/nt.mjs up --file example/age.nt",
    "nt:run": "node packages/cli/bin/nt.mjs run --file example/age.nt",
    "nt:chat": "node packages/cli/bin/nt.mjs chat age --file example/age.nt",
    "nt:audit": "node packages/cli/bin/nt.mjs audit --file example/age.nt",
    "docs:dev": "pnpm --filter @age.nt/docs dev",
    "docs:build": "pnpm --filter @age.nt/docs build",
    "docs:start": "pnpm --filter @age.nt/docs start",
    "build": "pnpm --filter @age.nt/engine build && pnpm --filter @age.nt/nt build",
    "format": "prettier --write .",
    "test": "node --conditions=development --test \"packages/engine/test/*.test.ts\" \"packages/cli/test/*.test.ts\" && node scripts/test-packed-cli.mjs",
    "typecheck": "pnpm build",
    "check:conventions": "node scripts/check-code-conventions.mjs",
    "check:docs": "node scripts/check-docs-consistency.mjs",
    "lint": "eslint . && pnpm check:conventions && pnpm check:docs",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "prepare": "pnpm build && husky"
  },
  "lint-staged": {
    "*.{ts,mts,mjs,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "overrides": {
      "@orama/orama": "3.1.14",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "nanoid@<3.3.17": ">=3.3.18",
      "postcss@<8.5.18": ">=8.5.18",
      "sharp@<0.35.0": ">=0.35.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr"
      ]
    }
  }
}
